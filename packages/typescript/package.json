{
  "name": "@greyfoundry/identifold",
  "version": "0.0.0",
  "description": "TypeScript reference implementation of the Identifold specification.",
  "keywords": [
    "identifier",
    "typeid",
    "uuid",
    "uuidv7"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/greyfoundry/identifold#readme",
  "bugs": {
    "url": "https://github.com/greyfoundry/identifold/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyfoundry/identifold.git",
    "directory": "packages/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "test:database": "vitest run test/database.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typeid-js": "^1.2.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@prisma/client": ">=7 <9",
    "drizzle-orm": ">=0.45 <1",
    "pg": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.2",
    "fast-check": "^4.9.0",
    "pg": "^8.23.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
